<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutAmigos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_register_screen"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Amigos"
        android:textSize="31sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/bb_text_primary"
        android:layout_gravity="center_horizontal"
        android:paddingBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1">

            <EditText
                android:id="@+id/edtPesquisar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Procurar utilizador..."
                android:padding="12dp"
                android:paddingEnd="44dp"
                android:background="@drawable/bg_register_input"
                android:textColor="@color/bb_text_primary"
                android:textColorHint="@color/bb_text_secondary"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

            <ImageView
                android:id="@+id/btnPesquisar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_search"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:contentDescription="Pesquisar"
                app:tint="#000000" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:id="@+id/layoutAddAmigo">

        <Button
            android:id="@+id/btnAdicionarAmigo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/adicionar_amigo"
            android:background="@drawable/bg_button_secondary"
            android:textColor="@color/bb_secondary_text"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"/>
    </LinearLayout>

    <!-- NOVO bloco: Pedidos de amizade recebidos -->
    <TextView
        android:id="@+id/txtPedidosAmizade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pedidos de amizade recebidos"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/bb_text_primary"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPedidosAmizade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <!-- Lista de convites recebidos -->
    <TextView
        android:id="@+id/txtConvites"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/convites_recebidos"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/bb_text_primary"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerConvites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/txtSeusAmigos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/teus_amigos"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/bb_text_primary"
        android:layout_marginTop="20dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAmigos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="6dp"/>

    <!-- Botão Voltar -->
    <LinearLayout
        android:id="@+id/btn_voltar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="8dp"
        android:background="@drawable/bg_register_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/voltar"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
