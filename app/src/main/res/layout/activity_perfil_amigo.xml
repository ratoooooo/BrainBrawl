<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clPerfilAmigo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- Card Centralizado -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/bb_space_lg"
        android:layout_marginTop="@dimen/bb_space_lg"
        android:layout_marginEnd="@dimen/bb_space_lg"
        android:layout_marginBottom="@dimen/bb_space_md"
        app:cardCornerRadius="@dimen/bb_radius_lg"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/bb_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnVoltarPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/bb_space_lg">

            <!-- AVATAR GRANDE -->
            <ImageView
                android:id="@+id/imgAvatarAmigo"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginBottom="12dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/avatar_do_amigo" />

            <!-- Nome do Amigo -->
            <TextView
                android:id="@+id/txtNomeAmigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/nome_amigo"
                android:textColor="@color/bb_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/nivel_inicial"
                android:textColor="@color/bb_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtXpProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@string/xp_progress_format"
                android:textColor="@color/bb_text_secondary"
                android:textSize="13sp" />


            <!-- Linha das Conquistas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="4dp">

                <!-- Total de Jogos -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/imgTotalJogos"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:contentDescription="@string/total_de_jogos" />
                    <TextView
                        android:id="@+id/txtTotalJogosConquista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jogos"
                        android:textSize="12sp"
                        android:textColor="@color/bb_text_secondary"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Espaçamento entre conquistas -->
                <Space
                    android:layout_width="32dp"
                    android:layout_height="0dp"/>

                <!-- Total de Vitórias -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/imgTotalVitorias"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:contentDescription="@string/total_de_vitorias" />
                    <TextView
                        android:id="@+id/txtTotalVitoriasConquista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vit_rias"
                        android:textSize="12sp"
                        android:textColor="@color/bb_text_secondary"
                        android:gravity="center"/>
                </LinearLayout>

                <Space
                    android:layout_width="32dp"
                    android:layout_height="0dp"/>

                <!-- Total de Respostas Certas -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/imgTotalRespostasCertas"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:contentDescription="@string/total_de_respostas_certas" />
                    <TextView
                        android:id="@+id/txtTotalRespostasCertasConquista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/respostas_certas_abrev"
                        android:textSize="12sp"
                        android:textColor="@color/bb_text_secondary"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Pontuação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconPontuacao"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/pontuacao"
                    android:src="@drawable/ic_star" />

                <TextView
                    android:id="@+id/txtPontuacao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="2"
                    android:text="@string/pontuacao_format"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Total de Jogos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconJogos"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/jogos"
                    android:src="@drawable/ic_sport" />

                <TextView
                    android:id="@+id/txtTotalJogos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="2"
                    android:text="@string/total_de_jogos_format"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Total de Vitórias -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconVitorias"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/vit_rias"
                    android:src="@drawable/ic_trophy" />

                <TextView
                    android:id="@+id/txtTotalVitorias"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="2"
                    android:text="@string/total_de_vitorias_format"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Taxa de Acertos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconTaxa"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/taxa_de_acertos"
                    android:src="@drawable/ic_percent" />

                <TextView
                    android:id="@+id/txtTaxaAcertos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="2"
                    android:text="@string/taxa_de_vitoria_format"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtConquistasTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/melhores_conquistas"
                android:textColor="@color/bb_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtConquistasEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/melhores_conquistas_publicas"
                android:textColor="@color/bb_text_secondary"
                android:textSize="12sp" />

            <GridLayout
                android:id="@+id/gridConquistas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="3"
                android:useDefaultMargins="false" />

            <Button
                android:id="@+id/btnVerConquistas"
                style="@style/BrainBrawlButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bb_button_height"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/ver_conquistas"
                android:textAllCaps="false"
                android:textColor="@color/bb_secondary_text" />

            <!-- Botão Remover Amigo dentro do card -->
            <Button
                android:id="@+id/btnRemoverAmigo"
                style="@style/BrainBrawlButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/bb_button_height"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_danger"
                android:text="@string/remover_amigo"
                android:textAllCaps="false"
                android:textColor="@color/bb_primary_text"
                android:drawableStart="@drawable/ic_delete"
                android:drawablePadding="8dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
        </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnVoltarPerfil"
        style="@style/BrainBrawlButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/bb_button_height"
        android:background="@drawable/bg_button_danger"
        android:text="@string/voltar"
        android:textAllCaps="false"
        android:textColor="@color/bb_primary_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.85"
        android:layout_marginBottom="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
