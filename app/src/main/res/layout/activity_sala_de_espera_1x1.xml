<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_premium"
    tools:context=".SalaDeEspera1x1Activity">

    <ImageButton
        android:id="@+id/btnBackHeader"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="42dp"
        android:background="@drawable/bg_choose_back_button"
        android:contentDescription="@string/voltar"
        android:padding="10dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/bb_luso_gold" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="88dp"
            android:paddingBottom="34dp">

            <TextView
                android:id="@+id/txtTituloSala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/sala_de_espera_1x1"
                android:textColor="@color/bb_luso_navy"
                android:textSize="31sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="126dp"
                android:layout_height="16dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#55D8C49D" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_accent_diamond" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#55D8C49D" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardStatusSala"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_main_mode_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/iconStatusSala"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_hourglass" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtStatusTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="@string/sala_status_aguardar_adversario"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtStatusDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/sala_status_aguardar_adversario_desc"
                        android:textColor="@color/bb_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCodigoSala"
                android:layout_width="match_parent"
                android:layout_height="102dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_main_hero_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/codigo_da_sala_label"
                        android:textColor="@color/bb_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtCodigoSala"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="@string/c_digo_da_sala"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCopiarCodigoSala"
                    android:layout_width="104dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button_secondary"
                    android:drawableStart="@drawable/ic_copy"
                    android:drawablePadding="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/copiar"
                    android:textAllCaps="false"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtJogadores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/jogadores_na_sala"
                android:textColor="@color/bb_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="278dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_main_hero_card"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/slotJogador1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgJogador1Avatar"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:src="@drawable/avatar_1_playstore" />

                    <TextView
                        android:id="@+id/txtJogador1Nome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:ellipsize="end"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/nome_jogador"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtJogador1Papel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_waiting_badge_gold"
                        android:fontFamily="sans-serif-black"
                        android:paddingStart="14dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="5dp"
                        android:text="@string/anfitriao"
                        android:textColor="@color/bb_primary_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtJogador1Estado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/pronto_estado"
                        android:textColor="@color/bb_success"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#26D8A42F" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="VS"
                    android:textColor="@color/bb_luso_gold"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#26D8A42F" />

                <LinearLayout
                    android:id="@+id/slotJogador2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgJogador2Avatar"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:background="@drawable/bg_game_type_icon"
                        android:padding="16dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/bb_luso_navy" />

                    <TextView
                        android:id="@+id/txtJogador2Nome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:ellipsize="end"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/aguardando_adversario_curto"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtJogador2Estado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_waiting_badge_soft"
                        android:fontFamily="sans-serif"
                        android:paddingStart="14dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="5dp"
                        android:text="@string/aguardando_estado"
                        android:textColor="@color/bb_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtListaJogadores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnIniciarJogo"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_main_black_button"
                android:fontFamily="sans-serif-black"
                android:text="@string/pronto"
                android:textAllCaps="false"
                android:textColor="@color/bb_primary_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSairSala"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_secondary"
                android:fontFamily="sans-serif-black"
                android:text="@string/sair_da_sala"
                android:textAllCaps="false"
                android:textColor="@color/bb_luso_navy"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_shield_clean"
                    app:tint="@color/bb_text_secondary" />

                <TextView
                    android:id="@+id/txtFooterInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/o_jogo_comeca_ambos_prontos"
                    android:textColor="@color/bb_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
