<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FFC400">

    <TextView
        android:id="@+id/txtTituloSala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sala_de_espera_1x1"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtCodigoSala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/c_digo_da_sala"
        android:textSize="18sp"
        android:textColor="#000000"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtJogadores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jogadores_na_sala"
        android:textSize="18sp"
        android:textColor="#000000"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtListaJogadores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aguardando_jogadores"
        android:textSize="18sp"
        android:textColor="#000000"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnIniciarJogo"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:text="@string/iniciar_jogo"
        android:enabled="false"
        android:textColor="#000000"
        android:background="@drawable/botao_branco_arredondado"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        android:layout_marginTop="24dp" />

</LinearLayout>