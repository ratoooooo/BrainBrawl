<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/bb_space_lg"
    android:background="@drawable/bg_app_gradient">

    <TextView
        android:id="@+id/txtTituloSala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sala_de_espera_1x1"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/bb_text_primary"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/layoutCodigoSala"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_empty_state_card"
        android:padding="@dimen/bb_space_md"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/txtCodigoSala"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/c_digo_da_sala"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@color/bb_text_primary"
            android:fontFamily="sans-serif-black"
            android:maxLines="2"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/btnCopiarCodigoSala"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Copiar código"
            android:padding="8dp"
            android:src="@drawable/ic_copy"
            app:tint="@color/bb_text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtJogadores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jogadores_na_sala"
        android:textSize="18sp"
        android:textColor="@color/bb_text_primary"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtListaJogadores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/aguardando_jogadores"
        android:textSize="18sp"
        android:gravity="center"
        android:background="@drawable/bg_card_surface"
        android:padding="@dimen/bb_space_md"
        android:textColor="@color/bb_text_primary"
        android:fontFamily="sans-serif-black"
        android:maxLines="4"
        android:ellipsize="end"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnIniciarJogo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bb_button_height"
        android:text="@string/iniciar_jogo"
        android:enabled="false"
        android:textColor="@color/bb_secondary_text"
        android:background="@drawable/bg_button_secondary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btnSairSala"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bb_button_height"
        android:text="@string/sair_da_sala"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_button_danger"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

</LinearLayout>
