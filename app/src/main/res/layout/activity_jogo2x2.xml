<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_premium"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_game_header"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/categoria"
                android:src="@drawable/ic_shield_clean"
                app:tint="@color/bb_luso_gold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCategoriaJogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:textColor="@color/bb_primary_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="História" />

                <TextView
                    android:id="@+id/txt_progresso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progresso_pergunta"
                    android:textColor="@color/bb_luso_surface"
                    android:textSize="13sp"
                    tools:text="5 / 10" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_game_timer_pill"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/bb_danger" />

                <TextView
                    android:id="@+id/txt_cronometro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/cronometro_inicial"
                    android:textColor="@color/bb_danger"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_tempo"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginStart="42dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="42dp"
            android:indeterminate="false"
            android:max="20"
            android:progress="20"
            android:progressBackgroundTint="#31506C"
            android:progressTint="@color/bb_luso_gold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgEquipaA1"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_game_avatar"
                            android:contentDescription="@string/avatar_do_jogador"
                            android:padding="2dp"
                            tools:src="@drawable/avatar_1_playstore" />

                        <ImageView
                            android:id="@+id/imgEquipaA2"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="-12dp"
                            android:background="@drawable/bg_game_avatar"
                            android:contentDescription="@string/avatar_do_jogador"
                            android:padding="2dp"
                            tools:src="@drawable/avatar_2_playstore" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtNomeEquipaA"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Equipa Lusa" />

                    <TextView
                        android:id="@+id/txtPontosEquipaA"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        tools:text="2.230" />
                </LinearLayout>

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_game_vs"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/versus_short"
                    android:textColor="@color/bb_primary_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgEquipaB1"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_game_avatar"
                            android:contentDescription="@string/avatar_do_jogador"
                            android:padding="2dp"
                            tools:src="@drawable/avatar_3_playstore" />

                        <ImageView
                            android:id="@+id/imgEquipaB2"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="-12dp"
                            android:background="@drawable/bg_game_avatar"
                            android:contentDescription="@string/avatar_do_jogador"
                            android:padding="2dp"
                            tools:src="@drawable/avatar_4_playstore" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtNomeEquipaB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Os Descobridores" />

                    <TextView
                        android:id="@+id/txtPontosEquipaB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        tools:text="1.780" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_game_gold_bar" />

                <View
                    android:layout_width="56dp"
                    android:layout_height="match_parent" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_game_blue_bar" />
            </LinearLayout>

            <include
                android:id="@+id/questionAnswers"
                layout="@layout/layout_game_question_answers" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
