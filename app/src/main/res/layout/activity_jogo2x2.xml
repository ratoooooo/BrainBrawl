<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txt_progresso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/progresso_pergunta"
        android:textColor="@color/bb_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/pb_tempo"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="264dp"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        android:max="20"
        android:minWidth="250dp"
        android:minHeight="28dp"
        android:progress="1"
        android:progressBackgroundTint="@color/bb_outline"
        android:progressTint="@color/bb_accent" />


    <ImageView
        android:id="@+id/img_pergunta"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:adjustViewBounds="true"
        android:scaleType="centerInside"
        android:visibility="gone"
        android:background="@drawable/botao_branco_arredondado" />

    <TextView
        android:id="@+id/txt_pergunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="32dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/botao_branco_arredondado"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/carregar_perguntas"
        android:textColor="@color/bb_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_cronometro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/cronometro_inicial"
        android:textColor="@color/bb_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_opcao_1"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/botao_branco_arredondado"
        android:elevation="2dp"
        android:paddingVertical="12dp"
        android:stateListAnimator="@null"
        android:text="@string/opcao_a"
        android:textColor="@color/bb_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_opcao_2"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/botao_branco_arredondado"
        android:elevation="2dp"
        android:paddingVertical="12dp"
        android:stateListAnimator="@null"
        android:text="@string/opcao_b"
        android:textColor="@color/bb_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_opcao_3"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/botao_branco_arredondado"
        android:elevation="2dp"
        android:paddingVertical="12dp"
        android:stateListAnimator="@null"
        android:text="@string/opcao_c"
        android:textColor="@color/bb_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_opcao_4"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/botao_branco_arredondado"
        android:elevation="2dp"
        android:paddingVertical="12dp"
        android:stateListAnimator="@null"
        android:text="@string/opcao_d"
        android:textColor="@color/bb_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold" />

</LinearLayout>