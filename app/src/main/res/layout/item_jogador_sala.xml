<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="#FFFFFF">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/imgAvatarJogador"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="10dp"
        android:scaleType="centerCrop"
        android:contentDescription="Avatar do jogador"/>

    <!-- Estado -->
    <View
        android:id="@+id/viewEstadoJogador"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_estado_circle"/>

    <!-- Nome -->
    <TextView
        android:id="@+id/txtNomeJogador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Nome do jogador"
        android:textSize="18sp"
        android:textColor="#000"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"/>
</LinearLayout>