<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_premium"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="118dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header_area"
                android:layout_width="match_parent"
                android:layout_height="130dp">

                <FrameLayout
                    android:id="@+id/avatar_frame"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_main_avatar_ring"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/img_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/perfil"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_1_playstore" />

                    <TextView
                        android:id="@+id/txt_level_badge"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_main_level_badge"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txt_ola"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/ola"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="19sp"
                    app:layout_constraintEnd_toStartOf="@id/header_actions"
                    app:layout_constraintStart_toEndOf="@id/avatar_frame"
                    app:layout_constraintTop_toTopOf="@id/avatar_frame" />

                <TextView
                    android:id="@+id/txt_boas_vindas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="10dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:text="@string/bem_vindo"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/header_actions"
                    app:layout_constraintStart_toEndOf="@id/avatar_frame"
                    app:layout_constraintTop_toBottomOf="@id/txt_ola" />

                <TextView
                    android:id="@+id/txt_nivel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="9dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/nivel_inicial"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="14sp"
                    app:layout_constraintStart_toEndOf="@id/avatar_frame"
                    app:layout_constraintTop_toBottomOf="@id/txt_boas_vindas" />

                <ProgressBar
                    android:id="@+id/progress_xp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="9dp"
                    android:layout_marginEnd="10dp"
                    android:max="600"
                    android:progress="260"
                    android:progressDrawable="@drawable/bg_main_xp_progress"
                    app:layout_constraintEnd_toStartOf="@id/txt_xp"
                    app:layout_constraintStart_toEndOf="@id/avatar_frame"
                    app:layout_constraintTop_toBottomOf="@id/txt_nivel" />

                <TextView
                    android:id="@+id/txt_xp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/xp_progress_format"
                    android:textColor="#6B5B46"
                    android:textSize="12sp"
                    app:layout_constraintBaseline_toBaselineOf="@id/progress_xp"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="260 / 600 XP" />

                <LinearLayout
                    android:id="@+id/header_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:baselineAligned="false"
                    android:gravity="top|end"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:id="@+id/btn_ranking"
                        android:layout_width="50dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_header_action_tint"
                        android:clickable="true"
                        android:contentDescription="@string/ranking"
                        android:focusable="true"
                        android:gravity="top|center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_main_icon_button">

                            <ImageView
                                android:layout_width="23dp"
                                android:layout_height="23dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_trophy"
                                app:tint="@color/bb_luso_navy" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/ranking"
                            android:textColor="@color/bb_luso_navy"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_historico"
                        android:layout_width="54dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_header_action_tint"
                        android:clickable="true"
                        android:contentDescription="@string/historico"
                        android:focusable="true"
                        android:gravity="top|center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_main_icon_button">

                            <ImageView
                                android:layout_width="23dp"
                                android:layout_height="23dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_history"
                                app:tint="@color/bb_luso_navy" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/historico"
                            android:textColor="@color/bb_luso_navy"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_voltar"
                        android:layout_width="44dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_header_action_tint"
                        android:clickable="true"
                        android:contentDescription="@string/terminar_sessao"
                        android:focusable="true"
                        android:gravity="top|center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_main_icon_button">

                            <ImageView
                                android:layout_width="23dp"
                                android:layout_height="23dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_logout"
                                app:tint="@color/bb_luso_navy" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/sair"
                            android:textColor="@color/bb_luso_navy"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/hero_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_main_hero_card"
                android:elevation="3dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="28dp"
                android:paddingEnd="22dp"
                android:paddingBottom="22dp">

                <TextView
                    android:id="@+id/txt_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/vamos_jogar"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="35sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/img_hero_brain"
                    android:layout_width="156dp"
                    android:layout_height="144dp"
                    android:layout_marginTop="14dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/avatar_14_foreground" />

                <LinearLayout
                    android:id="@+id/btn_criar_sala"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_main_black_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="22dp"
                        android:contentDescription="@string/jogar_agora"
                        android:src="@drawable/ic_sword"
                        app:tint="@color/bb_luso_gold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/jogar_agora"
                        android:textColor="@color/bb_primary_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="22dp"
                        android:contentDescription="@string/jogar_agora"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/bb_luso_gold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_entrar_sala"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/entrar_numa_sala_caps"
                        android:src="@drawable/ic_group"
                        app:tint="@color/bb_luso_navy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/entrar_numa_sala_caps"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mode_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#55D8C49D" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/escolhe_teu_modo"
                    android:src="@drawable/ic_accent_diamond" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/escolhe_teu_modo"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/escolhe_teu_modo"
                    android:src="@drawable/ic_accent_diamond" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#55D8C49D" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mode_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_matchmaking_1x1"
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_main_mode_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/modo_1x1_aleatorio"
                        android:src="@drawable/ic_sword"
                        app:tint="@color/bb_luso_navy" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="@string/modo_1x1_aleatorio"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_matchmaking_2x2"
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_main_mode_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="39dp"
                        android:layout_height="39dp"
                        android:contentDescription="@string/modo_2x2_aleatorio"
                        android:src="@drawable/ic_shield_clean"
                        app:tint="@color/bb_luso_navy" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="@string/modo_2x2_aleatorio"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_explorar_categorias"
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_main_mode_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/explorar_categorias"
                        android:src="@drawable/ic_search"
                        app:tint="@color/bb_luso_navy" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="@string/explorar_categorias_duas_linhas"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_main_bottom_nav"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="36dp">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="@color/bb_luso_navy" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/inicio"
                android:textColor="@color/bb_luso_navy"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="44dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@color/bb_luso_gold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_ranking_nav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_trophy"
                app:tint="#6B5B46" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/ranking"
                android:textColor="#6B5B46"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_add_amigo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/img_add_amigo"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_group"
                    app:tint="#6B5B46" />

                <TextView
                    android:id="@+id/notification_badge_amigos"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_notification_badge"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_add_amigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/amigos"
                android:textColor="#6B5B46"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_perfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_person"
                app:tint="#6B5B46" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/perfil"
                android:textColor="#6B5B46"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
