<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFC400"
    android:padding="24dp">

    <!-- Guideline para definir a área central mais acima -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.22" />

    <!-- Botão "Convidar amigo" no topo, escondido -->
    <LinearLayout
        android:id="@+id/btn_add_amigo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/img_add_amigo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_add"
            app:tint="#000000"
            android:visibility="visible" />

        <TextView
            android:id="@+id/txt_add_amigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/convidar_amigo"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:visibility="visible" />
    </LinearLayout>

    <!-- Título "Bem-Vindo" -->
    <TextView
        android:id="@+id/txt_boas_vindas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bem_vindo"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="@id/guideline_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Título principal -->
    <TextView
        android:id="@+id/txt_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="40sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/txt_boas_vindas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Código da Sala -->
    <TextView
        android:id="@+id/txt_codigo_sala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/codigo_sala_nenhum"
        android:textSize="18sp"
        android:textColor="#1B1B1B"
        android:fontFamily="sans-serif-black"
        app:layout_constraintTop_toBottomOf="@id/txt_titulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Botão Criar Sala -->
    <Button
        android:id="@+id/btn_criar_sala"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/criar_sala"
        android:textSize="18sp"
        android:textColor="#000000"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        android:background="@drawable/botao_branco_arredondado"
        style="@android:style/Widget.Button"
        android:paddingVertical="14dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/txt_codigo_sala"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.85" />

    <!-- Botão Entrar numa Sala -->
    <Button
        android:id="@+id/btn_entrar_sala"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/entrar_sala"
        android:textSize="18sp"
        android:textColor="#000000"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        android:background="@drawable/botao_branco_arredondado"
        android:paddingVertical="14dp"
        style="@android:style/Widget.Button"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/btn_criar_sala"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.85" />


    <!-- Botão Voltar com ícone e texto -->
    <LinearLayout
        android:id="@+id/btn_voltar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/botao_voltar"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/btn_entrar_sala"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.85">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/voltar"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>