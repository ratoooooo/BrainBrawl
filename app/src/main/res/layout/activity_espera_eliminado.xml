<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FFC400">

    <TextView
        android:id="@+id/txtTituloEsperaEliminado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Foste eliminado"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtCodigoSala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Código da Sala:"
        android:textSize="18sp"
        android:textColor="#000000"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="24dp" />

    <ProgressBar
        android:id="@+id/progressAguardarPodio"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/txtEstadoEsperaEliminado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A aguardar o fim da partida..."
        android:textSize="18sp"
        android:textColor="#000000"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold" />

</LinearLayout>
