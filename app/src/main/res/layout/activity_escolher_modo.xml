<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_premium"
    tools:context=".EscolherModoActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/layout_conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/bb_screen_padding"
            android:paddingTop="40dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/txt_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/escolher_modo_jogo"
                android:textAllCaps="true"
                android:textColor="@color/bb_text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btn_modo_classico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_main_mode_card"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="112dp"
                android:orientation="horizontal"
                android:padding="@dimen/bb_card_padding">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_main_icon_button"
                    android:contentDescription="@string/modo_classico"
                    android:padding="14dp"
                    android:src="@drawable/ic_sword" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/modo_classico"
                        android:textColor="@color/bb_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/dica_modo_classico_texto"
                        android:textColor="@color/bb_text_secondary"
                        android:textSize="@dimen/bb_caption_size" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_modo_caotico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_main_mode_card"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="112dp"
                android:orientation="horizontal"
                android:padding="@dimen/bb_card_padding">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_main_icon_button"
                    android:contentDescription="@string/modo_caotico"
                    android:padding="14dp"
                    android:src="@drawable/ic_bomb" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/modo_caotico"
                        android:textColor="@color/bb_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/dica_modo_caotico_texto"
                        android:textColor="@color/bb_text_secondary"
                        android:textSize="@dimen/bb_caption_size" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_modo_eliminatorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_main_mode_card"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="112dp"
                android:orientation="horizontal"
                android:padding="@dimen/bb_card_padding">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_main_icon_button"
                    android:contentDescription="@string/modo_eliminatorias"
                    android:padding="14dp"
                    android:src="@drawable/ic_kill" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/modo_eliminatorias"
                        android:textColor="@color/bb_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/dica_modo_eliminatorias_texto"
                        android:textColor="@color/bb_text_secondary"
                        android:textSize="@dimen/bb_caption_size" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info_todos"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bb_button_height"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/info_todos"
                    android:src="@drawable/ic_eye" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/info_todos"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_voltar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bb_button_height"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/voltar"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/voltar"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
