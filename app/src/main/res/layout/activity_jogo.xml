<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_premium"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_game_header"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/categoria"
                android:src="@drawable/ic_shield_clean"
                app:tint="@color/bb_luso_gold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCategoriaJogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:textColor="@color/bb_primary_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="História" />

                <TextView
                    android:id="@+id/txt_progresso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progresso_pergunta"
                    android:textColor="@color/bb_luso_surface"
                    android:textSize="13sp"
                    tools:text="5 / 10" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_game_timer_pill"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/bb_danger" />

                <TextView
                    android:id="@+id/txt_cronometro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/cronometro_inicial"
                    android:textColor="@color/bb_danger"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_tempo"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginStart="42dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="42dp"
            android:indeterminate="false"
            android:max="20"
            android:progress="20"
            android:progressBackgroundTint="#31506C"
            android:progressTint="@color/bb_luso_gold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_admin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_waiting_badge_soft"
        android:fontFamily="sans-serif-black"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:text="@string/admin_label"
        android:textColor="@color/bb_luso_navy"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

            <ImageView
                android:id="@+id/img_pergunta"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="10dp"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_game_question_card"
                android:scaleType="centerInside"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_game_question_card"
                android:gravity="center_horizontal"
                android:minHeight="500dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/txt_pergunta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:minHeight="120dp"
                    android:text="@string/carregar_perguntas"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/luso_accent_line"
                    android:textColor="@color/bb_luso_gold"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_opcao_1"
                    style="@style/BrainBrawlButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_game_answer"
                    android:paddingHorizontal="16dp"
                    android:stateListAnimator="@null"
                    android:text="@string/opcao_a"
                    android:textAllCaps="false"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_opcao_2"
                    style="@style/BrainBrawlButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_game_answer"
                    android:paddingHorizontal="16dp"
                    android:stateListAnimator="@null"
                    android:text="@string/opcao_b"
                    android:textAllCaps="false"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_opcao_3"
                    style="@style/BrainBrawlButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_game_answer"
                    android:paddingHorizontal="16dp"
                    android:stateListAnimator="@null"
                    android:text="@string/opcao_c"
                    android:textAllCaps="false"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_opcao_4"
                    style="@style/BrainBrawlButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_game_answer"
                    android:paddingHorizontal="16dp"
                    android:stateListAnimator="@null"
                    android:text="@string/opcao_d"
                    android:textAllCaps="false"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
