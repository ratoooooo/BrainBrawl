<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_register_screen">

    <ScrollView
        android:id="@+id/register_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/layout_conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btn_voltar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start"
                android:background="@drawable/bg_register_icon_button"
                android:clickable="true"
                android:contentDescription="@string/voltar"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="@string/voltar"
                    android:src="@drawable/ic_back"
                    app:tint="@color/bb_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/register_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:contentDescription="@string/app_name"
                    android:src="@mipmap/avatar_14_foreground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/brand_full_caps"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_registo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/cria_tua_conta"
                android:textColor="@color/bb_text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_registo_subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/registo_subtitulo"
                android:textColor="@color/bb_text_secondary"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/register_stepper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_step_conta"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_register_step_active"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="72dp"
                    android:layout_height="2dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/bb_outline" />

                <TextView
                    android:id="@+id/txt_step_perfil"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_register_step_idle"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/bb_text_secondary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/page_conta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/email_field"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_register_input"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/email"
                        android:src="@drawable/ic_mail"
                        app:tint="@color/bb_text_primary" />

                    <EditText
                        android:id="@+id/edt_email"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="sans-serif"
                        android:hint="@string/email"
                        android:inputType="textEmailAddress"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/bb_text_primary"
                        android:textColorHint="#716657"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/password_field"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_register_input"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/insira_password"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/bb_text_primary" />

                    <EditText
                        android:id="@+id/edt_password_jogador"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="sans-serif"
                        android:hint="@string/password_hint"
                        android:inputType="textPassword"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/bb_text_primary"
                        android:textColorHint="#716657"
                        android:textSize="18sp" />

                    <ImageView
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@string/mostrar_password"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/bb_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/confirm_password_field"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_register_input"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/confirmar_password"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/bb_text_primary" />

                    <EditText
                        android:id="@+id/edt_confirmar_password"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="sans-serif"
                        android:hint="@string/confirmar_password"
                        android:inputType="textPassword"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/bb_text_primary"
                        android:textColorHint="#716657"
                        android:textSize="18sp" />

                    <ImageView
                        android:id="@+id/btnToggleConfirmarPassword"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@string/mostrar_confirmacao_password"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/bb_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/password_requirements_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_register_info_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/password_requisitos_titulo"
                        android:textColor="@color/bb_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="6dp"
                        android:text="@string/password_requisitos"
                        android:textColor="@color/bb_text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_continuar_registo"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_register_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/continuar"
                        android:textColor="@color/bb_primary_text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="›"
                        android:textColor="@color/bb_accent"
                        android:textSize="42sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_login_link"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="@string/ja_tens_conta"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/page_perfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/name_field"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_register_input"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/insira_nome"
                        android:src="@drawable/ic_person"
                        app:tint="@color/bb_text_primary" />

                    <EditText
                        android:id="@+id/edt_nome_jogador"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="sans-serif"
                        android:hint="@string/nome_utilizador"
                        android:inputType="textPersonName"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/bb_text_primary"
                        android:textColorHint="#716657"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/avatar_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_register_avatar_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/img_avatar_selecionado"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="@string/avatar_selecionado"
                        android:elevation="3dp"
                        android:padding="0dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_1_playstore" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/escolhe_avatar"
                        android:textColor="@color/bb_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <GridView
                        android:id="@+id/grid_avatars"
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:layout_marginTop="16dp"
                        android:clipToPadding="false"
                        android:horizontalSpacing="12dp"
                        android:numColumns="4"
                        android:padding="2dp"
                        android:stretchMode="columnWidth"
                        android:verticalSpacing="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_registar"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_register_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/criar_conta_caps"
                        android:textColor="@color/bb_primary_text"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_voltar_etapa"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_register_icon_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/voltar"
                        android:textColor="@color/bb_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
