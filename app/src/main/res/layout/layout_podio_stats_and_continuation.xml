<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutPodioStats"
        android:layout_width="match_parent"
        android:layout_height="118dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_card_surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/txtPodioStatRodadas"
            style="@style/Widget_BrainBrawl_PodioStat"
            android:text="8" />

        <View style="@style/Widget_BrainBrawl_PodioDivider" />

        <TextView
            android:id="@+id/txtPodioStatPrecisao"
            style="@style/Widget_BrainBrawl_PodioStat"
            android:text="87%" />

        <View style="@style/Widget_BrainBrawl_PodioDivider" />

        <TextView
            android:id="@+id/txtPodioStatAcertos"
            style="@style/Widget_BrainBrawl_PodioStat"
            android:text="7" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutPodioStatsLabels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-44dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            style="@style/Widget_BrainBrawl_PodioStatLabel"
            android:text="@string/rodadas" />

        <TextView
            style="@style/Widget_BrainBrawl_PodioStatLabel"
            android:text="@string/precisao" />

        <TextView
            style="@style/Widget_BrainBrawl_PodioStatLabel"
            android:text="@string/acertos" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutRankingContinuacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_ranking_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/restantes_jogadores"
            android:textColor="@color/bb_luso_navy"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPodioContinuacao"
            android:layout_width="match_parent"
            android:layout_height="174dp"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="true"
            tools:itemCount="4"
            tools:listitem="@layout/item_podio_continuacao" />

        <TextView
            android:id="@+id/txtPodioContinuacaoEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/sem_restantes_podio"
            android:textColor="@color/bb_text_secondary"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
