<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bb_surface_strong"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minHeight="136dp"
        android:orientation="vertical"
        android:padding="10dp">

        <ImageView
            android:id="@+id/imgBadge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/conquista"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/txtBadgeNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/bb_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtBadgeEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/bb_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtBadgeProgresso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/bb_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
