<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_surface"
    android:elevation="4dp"
    android:layout_marginBottom="10dp"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/txt_medalha"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="🥇"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/bb_accent"
        android:background="@android:color/transparent" />

    <TextView
        android:id="@+id/txt_nome_jogador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/nome_jogador"
        android:textSize="20sp"
        android:textColor="@color/bb_text_primary"
        android:fontFamily="sans-serif-black"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/txt_pontos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="999"
        android:textStyle="bold"
        android:textColor="@color/bb_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"/>
</LinearLayout>
