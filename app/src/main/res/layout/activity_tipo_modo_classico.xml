<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context=".TipoModoClassico">

    <LinearLayout
        android:id="@+id/layout_conteudo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center_horizontal">

        <!-- Título -->
        <TextView
            android:id="@+id/txt_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:letterSpacing="0.05"
            android:text="@string/escolher_tipo_modo_classico"
            android:textAllCaps="true"
            android:textColor="@color/bb_text_primary"
            android:textSize="36sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:gravity="center"/>

        <!-- Botão 1x1 -->
        <LinearLayout
            android:id="@+id/btn_modo_1x1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginHorizontal="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_solo"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/modo_1x1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modo_1x1"
                android:textSize="18sp"
                android:textColor="@color/bb_text_primary"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Botão 2x2 -->
        <LinearLayout
            android:id="@+id/btn_modo_2x2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginHorizontal="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_duo"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/modo_2x2"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modo_2x2"
                android:textSize="18sp"
                android:textColor="@color/bb_text_primary"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Botão Grupo (Todos) -->
        <LinearLayout
            android:id="@+id/btn_modo_grupo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginHorizontal="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_group"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/modo_todos"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modo_todos"
                android:textSize="18sp"
                android:textColor="@color/bb_text_primary"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Botão Voltar -->
        <LinearLayout
            android:id="@+id/btn_voltar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_danger"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginHorizontal="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/voltar"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voltar"
                android:textSize="18sp"
                android:textColor="@color/bb_primary_text"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Botão olho: canto inferior direito, alinhado com o botão voltar -->
    <ImageButton
        android:id="@+id/info_todos"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_eye"
        android:contentDescription="@string/info_todos_modos_classico"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="28dp"
        android:layout_marginEnd="24dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
