<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_premium"
    tools:context=".AdicionarPerguntaActivity">

    <ImageButton
        android:id="@+id/btn_back_header"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="42dp"
        android:background="@drawable/bg_choose_back_button"
        android:contentDescription="@string/voltar"
        android:elevation="8dp"
        android:padding="10dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/bb_luso_gold" />

    <ScrollView
        android:id="@+id/scroll_adicionar_pergunta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="88dp">

            <TextView
                android:id="@+id/txt_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/adicionar_nova_pergunta"
                android:textColor="@color/bb_luso_navy"
                android:textSize="29sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="126dp"
                android:layout_height="16dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#55D8C49D" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_accent_diamond" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#55D8C49D" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_main_hero_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/insira_nome_categoria"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edt_nova_categoria"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_register_input"
                    android:hint="@string/hint_nova_categoria"
                    android:inputType="textCapWords"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/bb_luso_navy"
                    android:textColorHint="@color/bb_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/descricao_categoria"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edt_descricao_categoria"
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_register_input"
                    android:gravity="top|start"
                    android:hint="@string/hint_descricao_categoria"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="140"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/bb_luso_navy"
                    android:textColorHint="@color/bb_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/icone_categoria"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_icone_categoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_category_action"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <RadioButton
                        android:id="@+id/rb_icon_default"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/bb_luso_gold"
                        android:checked="true"
                        android:gravity="center"
                        android:text="@string/icone_padrao"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rb_icon_history"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/bb_luso_gold"
                        android:gravity="center"
                        android:text="@string/icone_historia"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rb_icon_geo"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/bb_luso_gold"
                        android:gravity="center"
                        android:text="@string/icone_geografia"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="11sp" />
                </RadioGroup>

                <RadioGroup
                    android:id="@+id/rg_icone_categoria_linha_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_category_action"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <RadioButton
                        android:id="@+id/rb_icon_math"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/bb_luso_gold"
                        android:gravity="center"
                        android:text="@string/icone_matematica"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rb_icon_culture"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/bb_luso_gold"
                        android:gravity="center"
                        android:text="@string/icone_cultura"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rb_icon_science"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/bb_luso_gold"
                        android:gravity="center"
                        android:text="@string/icone_ciencia"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="11sp" />
                </RadioGroup>

                <TextView
                    android:id="@+id/txt_total_perguntas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/total_perguntas_inicial"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layout_perguntas_personalizadas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/pergunta_label"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edt_pergunta"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_register_input"
                    android:gravity="top|start"
                    android:hint="@string/insira_pergunta"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="200"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/bb_luso_navy"
                    android:textColorHint="@color/bb_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/opcoes_label"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_opcoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_opcao_a"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:buttonTint="@color/bb_luso_gold"
                        android:text="@string/opcao_a"
                        android:textColor="@color/bb_luso_navy"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edt_opcao_a"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="30dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_register_input"
                        android:hint="@string/hint_opcao_a"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />

                    <RadioButton
                        android:id="@+id/rb_opcao_b"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:buttonTint="@color/bb_luso_gold"
                        android:text="@string/opcao_b"
                        android:textColor="@color/bb_luso_navy"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edt_opcao_b"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="30dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_register_input"
                        android:hint="@string/hint_opcao_b"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />

                    <RadioButton
                        android:id="@+id/rb_opcao_c"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:buttonTint="@color/bb_luso_gold"
                        android:text="@string/opcao_c"
                        android:textColor="@color/bb_luso_navy"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edt_opcao_c"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="30dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_register_input"
                        android:hint="@string/hint_opcao_c"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />

                    <RadioButton
                        android:id="@+id/rb_opcao_d"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:buttonTint="@color/bb_luso_gold"
                        android:text="@string/opcao_d"
                        android:textColor="@color/bb_luso_navy"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edt_opcao_d"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="30dp"
                        android:background="@drawable/bg_register_input"
                        android:hint="@string/hint_opcao_d"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/imagem_opcional"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edt_imagem"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_register_input"
                    android:hint="@string/hint_imagem"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/bb_luso_navy"
                    android:textColorHint="@color/bb_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/dificuldade"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_dificuldade"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_category_action"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <RadioButton
                        android:id="@+id/rb_dificuldade_facil"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:buttonTint="@color/bb_success"
                        android:gravity="center"
                        android:text="@string/dificuldade_facil"
                        android:textColor="@color/bb_luso_navy" />

                    <RadioButton
                        android:id="@+id/rb_dificuldade_media"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:buttonTint="@color/bb_luso_gold"
                        android:checked="true"
                        android:gravity="center"
                        android:text="@string/dificuldade_media"
                        android:textColor="@color/bb_luso_navy" />

                    <RadioButton
                        android:id="@+id/rb_dificuldade_dificil"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:buttonTint="@color/bb_danger"
                        android:gravity="center"
                        android:text="@string/dificuldade_dificil"
                        android:textColor="@color/bb_luso_navy" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_btn_enviar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_main_black_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_book"
                    app:tint="@color/bb_luso_gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/enviar_pergunta"
                    android:textColor="@color/bb_primary_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_nova_pergunta"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_category_action"
                android:fontFamily="sans-serif-black"
                android:text="@string/nova_pergunta"
                android:textAllCaps="true"
                android:textColor="@color/bb_luso_navy"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_eliminar_pergunta_atual"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_category_action_danger"
                android:fontFamily="sans-serif-black"
                android:text="@string/eliminar_atual"
                android:textAllCaps="false"
                android:textColor="@color/bb_danger"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_btn_voltar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_category_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/bb_luso_navy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/voltar"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
