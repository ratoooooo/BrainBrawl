<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_premium"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="@dimen/bb_space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/bb_space_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/p_dio"
            android:textColor="@color/bb_luso_navy"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="128dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="@string/luso_accent_line"
            android:textColor="@color/bb_luso_gold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtSubtituloPodio1x1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="serif"
            android:text="@string/podio_grande_duelo"
            android:textColor="@color/bb_luso_gold"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutDuelPodium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:baselineAligned="false"
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardSegundoDuel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="44dp">

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="132dp">

                    <ImageView
                        android:id="@+id/imgAvatarSegundoDuel"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_gravity="top|center_horizontal"
                        android:background="@drawable/bg_ranking_avatar"
                        android:contentDescription="@string/avatar_do_jogador"
                        android:padding="4dp"
                        tools:src="@drawable/avatar_2_playstore" />

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:background="@drawable/bg_ranking_rank_silver"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/medalha_segundo"
                        android:textColor="@color/bb_primary_text"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtNomeSegundoDuel"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_button_secondary"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Lusitana" />

                <TextView
                    android:id="@+id/txtPontosSegundoDuel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    tools:text="2.180" />

                <TextView
                    android:id="@+id/txtResultadoSegundoDuel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/podio_derrota"
                    android:textColor="@color/bb_danger"
                    android:textSize="17sp"
                    tools:text="Derrota" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPrimeiroDuel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="152dp"
                    android:layout_height="180dp">

                    <TextView
                        android:layout_width="54dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|center_horizontal"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/medalha_primeiro"
                        android:textColor="@color/bb_luso_gold"
                        android:textSize="32sp" />

                    <ImageView
                        android:id="@+id/imgAvatarPrimeiroDuel"
                        android:layout_width="132dp"
                        android:layout_height="132dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="30dp"
                        android:background="@drawable/bg_ranking_avatar"
                        android:contentDescription="@string/avatar_do_jogador"
                        android:padding="4dp"
                        tools:src="@drawable/avatar_1_playstore" />

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:background="@drawable/bg_ranking_rank_gold"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/medalha_primeiro"
                        android:textColor="@color/bb_primary_text"
                        android:textSize="27sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtNomePrimeiroDuel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_button_secondary"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="jogador1" />

                <TextView
                    android:id="@+id/txtPontosPrimeiroDuel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:textColor="@color/bb_luso_gold"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    tools:text="3.450" />

                <TextView
                    android:id="@+id/txtResultadoPrimeiroDuel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/podio_vitoria"
                    android:textColor="@color/bb_success"
                    android:textSize="18sp"
                    tools:text="Vitória" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutStatsDuel"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card_surface"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtPodioStatPerguntas"
                    style="@style/Widget_BrainBrawl_PodioStat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:paddingBottom="2dp"
                    tools:text="20" />

                <TextView
                    style="@style/Widget_BrainBrawl_PodioStatLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="@string/podio_perguntas" />
            </LinearLayout>

            <View style="@style/Widget_BrainBrawl_PodioDivider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtPodioStatPrecisao"
                    style="@style/Widget_BrainBrawl_PodioStat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:paddingBottom="2dp"
                    tools:text="85%" />

                <TextView
                    style="@style/Widget_BrainBrawl_PodioStatLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="@string/precisao" />
            </LinearLayout>

            <View style="@style/Widget_BrainBrawl_PodioDivider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtPodioStatAcertos"
                    style="@style/Widget_BrainBrawl_PodioStat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:paddingBottom="2dp"
                    tools:text="7" />

                <TextView
                    style="@style/Widget_BrainBrawl_PodioStatLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="@string/acertos" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txt_estado_desforra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/bb_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_desforra"
            style="@style/BrainBrawlButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bb_button_height"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/jogar_novamente"
            android:textColor="@color/bb_primary_text" />

        <Button
            android:id="@+id/btn_voltar"
            style="@style/BrainBrawlButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bb_button_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/voltar"
            android:textColor="@color/bb_secondary_text" />
    </LinearLayout>
</ScrollView>
