<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clPerfilAmigo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- Card Centralizado -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/bb_space_lg"
        android:layout_marginEnd="@dimen/bb_space_lg"
        app:cardCornerRadius="@dimen/bb_radius_lg"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/bb_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnVoltarPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/bb_space_lg">

            <!-- AVATAR GRANDE -->
            <ImageView
                android:id="@+id/imgAvatarAmigo"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginBottom="12dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/avatar_do_amigo" />

            <!-- Nome do Amigo -->
            <TextView
                android:id="@+id/txtNomeAmigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-black"
                android:text="Nome Utilizador"
                android:textColor="@color/bb_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />


            <!-- Linha das Conquistas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="4dp">

                <!-- Total de Jogos -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/imgTotalJogos"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:contentDescription="@string/total_de_jogos" />
                    <TextView
                        android:id="@+id/txtTotalJogosConquista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jogos"
                        android:textSize="12sp"
                    android:textColor="@color/bb_text_secondary"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Espaçamento entre conquistas -->
                <Space
                    android:layout_width="32dp"
                    android:layout_height="0dp"/>

                <!-- Total de Vitórias -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/imgTotalVitorias"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:contentDescription="Total de Vitórias" />
                    <TextView
                        android:id="@+id/txtTotalVitoriasConquista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vitórias"
                        android:textSize="12sp"
                        android:textColor="@color/bb_text_secondary"
                        android:gravity="center"/>
                </LinearLayout>

                <Space
                    android:layout_width="32dp"
                    android:layout_height="0dp"/>

                <!-- Total de Respostas Certas -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/imgTotalRespostasCertas"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:contentDescription="Total de Respostas Certas" />
                    <TextView
                        android:id="@+id/txtTotalRespostasCertasConquista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resp. Certas"
                        android:textSize="12sp"
                        android:textColor="@color/bb_text_secondary"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Pontuação -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconPontuacao"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/pontuacao"
                    android:src="@drawable/ic_star" />

                <TextView
                    android:id="@+id/txtPontuacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/pontuacao"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtNivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:text="Nível 1"
                android:textColor="@color/bb_text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtXpProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:text="0 / 300 XP"
                android:textColor="@color/bb_text_secondary"
                android:textSize="16sp" />

            <!-- Total de Jogos -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconJogos"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/jogos"
                    android:src="@drawable/ic_sport" />

                <TextView
                    android:id="@+id/txtTotalJogos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/total_de_jogos"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Total de Vitórias -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconVitorias"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/vit_rias"
                    android:src="@drawable/ic_trophy" />

                <TextView
                    android:id="@+id/txtTotalVitorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/total_de_vit_rias_0"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Taxa de Acertos -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconTaxa"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/taxa_de_acertos"
                    android:src="@drawable/ic_percent" />

                <TextView
                    android:id="@+id/txtTaxaAcertos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/taxa_de_vit_ria"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="20sp" />
            </LinearLayout>

        </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnVoltarPerfil"
        style="@android:style/Widget.Button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_button_primary"
        android:paddingVertical="14dp"
        android:text="@string/voltar"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.85"
        android:layout_marginBottom="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
