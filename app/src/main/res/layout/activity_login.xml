<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFC400"
    tools:context=".LoginActivity">

    <!-- Guideline para centralizar verticalmente -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.3" />

    <!-- Título -->
    <TextView
        android:id="@+id/txt_registo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/entrar"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.04"
        app:layout_constraintTop_toTopOf="@id/gl_center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo email/nome -->
    <EditText
        android:id="@+id/edt_nome_jogador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Email ou nome"
        android:inputType="textEmailAddress"
        android:textSize="16sp"
        android:background="@drawable/edt_borda_preta"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="#0D0D0D"
        android:textColorHint="#6C757D"
        app:layout_constraintTop_toBottomOf="@id/txt_registo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.85"
        android:layout_marginTop="36dp" />

    <!-- Campo password -->
    <EditText
        android:id="@+id/edt_password_jogador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/insira_password"
        android:inputType="textPassword"
        android:textSize="16sp"
        android:background="@drawable/edt_borda_preta"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="#0D0D0D"
        android:textColorHint="#6C757D"
        app:layout_constraintTop_toBottomOf="@id/edt_nome_jogador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.85"
        android:layout_marginTop="16dp" />

    <!-- Botão Entrar -->
    <Button
        android:id="@+id/btn_entrar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/entrar"
        android:textSize="18sp"
        android:textColor="#000000"
        android:background="@drawable/botao_branco_arredondado"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        android:paddingVertical="14dp"
        style="@android:style/Widget.Button"
        app:layout_constraintTop_toBottomOf="@id/edt_password_jogador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.85"
        android:layout_marginTop="28dp" />

    <!-- Linha com os dois botões secundários -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/btn_entrar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        app:layout_constraintWidth_percent="0.85">

        <!-- Registar -->
        <Button
            android:id="@+id/btn_registo"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/registar"
            android:textSize="14sp"
            android:textColor="#000000"
            android:background="@drawable/botao_branco_arredondado"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:paddingVertical="10dp"
            style="@android:style/Widget.Button"
            android:layout_marginEnd="8dp" />

        <!-- Entrar sem conta -->
        <Button
            android:id="@+id/btn_iniciar_jogo"
            style="@android:style/Widget.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/botao_branco_arredondado"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:paddingVertical="10dp"
            android:text="@string/entrar_sem_conta"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
