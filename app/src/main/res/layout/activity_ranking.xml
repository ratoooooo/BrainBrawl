<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFC400"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/btn_voltar"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/botao_voltar"
        android:clickable="true"
        android:contentDescription="@string/voltar"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/voltar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_titulo_ranking"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="Ranking Global"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_voltar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_voltar"
        app:layout_constraintTop_toTopOf="@id/btn_voltar" />

    <LinearLayout
        android:id="@+id/layout_tipos_ranking"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_voltar">

        <Button
            android:id="@+id/btnRankingGlobal"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/botao_branco_arredondado"
            android:text="Global"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRankingSolo"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/botao_branco_arredondado"
            android:text="Solo"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRanking1x1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/botao_branco_arredondado"
            android:text="1x1"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRanking2x2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/botao_branco_arredondado"
            android:text="2x2"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_ranking"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_estado_ranking"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_ranking"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_tipos_ranking" />

</androidx.constraintlayout.widget.ConstraintLayout>
