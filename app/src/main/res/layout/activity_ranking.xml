<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_premium"
    tools:context=".RankingActivity">

    <ImageButton
        android:id="@+id/btn_voltar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="42dp"
        android:background="@drawable/bg_choose_back_button"
        android:contentDescription="@string/voltar"
        android:elevation="8dp"
        android:padding="10dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/bb_luso_gold" />

    <ScrollView
        android:id="@+id/scroll_ranking"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="82dp">

            <TextView
                android:id="@+id/txt_titulo_ranking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/ranking_global_titulo"
                android:textColor="@color/bb_luso_navy"
                android:textSize="31sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="126dp"
                android:layout_height="16dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#55D8C49D" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/ranking_global_titulo"
                    android:src="@drawable/ic_accent_diamond" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#55D8C49D" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_subtitulo_ranking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/top_10_arena"
                android:textColor="@color/bb_luso_gold"
                android:textSize="14sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/scroll_tipos_ranking"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="24dp"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_tipos_ranking"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnRankingSolo"
                    style="@style/Widget_BrainBrawl_RankingTab"
                    android:layout_width="84dp"
                    android:layout_weight="0"
                    android:layout_marginEnd="7dp"
                    android:drawableStart="@drawable/ic_person"
                    android:text="@string/ranking_solo" />

                <TextView
                    android:id="@+id/btnRanking1x1"
                    style="@style/Widget_BrainBrawl_RankingTab"
                    android:layout_width="74dp"
                    android:layout_weight="0"
                    android:layout_marginEnd="7dp"
                    android:drawableStart="@drawable/ic_sword"
                    android:text="@string/ranking_1x1" />

                <TextView
                    android:id="@+id/btnRanking2x2"
                    style="@style/Widget_BrainBrawl_RankingTab"
                    android:layout_width="74dp"
                    android:layout_weight="0"
                    android:layout_marginEnd="7dp"
                    android:drawableStart="@drawable/ic_shield_clean"
                    android:text="@string/ranking_2x2" />

                <TextView
                    android:id="@+id/btnRankingRecorde"
                    style="@style/Widget_BrainBrawl_RankingTab"
                    android:layout_width="96dp"
                    android:layout_weight="0"
                    android:layout_marginEnd="7dp"
                    android:drawableStart="@drawable/ic_target_clean"
                    android:text="@string/ranking_recorde" />

                    <TextView
                        android:id="@+id/btnRankingTotal"
                        style="@style/Widget_BrainBrawl_RankingTab"
                        android:layout_width="82dp"
                        android:layout_weight="0"
                        android:drawableStart="@drawable/ic_star"
                        android:text="@string/ranking_total" />
                </LinearLayout>
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="360dp">

                <ProgressBar
                    android:id="@+id/progress_ranking"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="100dp"
                    android:indeterminateTint="@color/bb_luso_gold" />

                <TextView
                    android:id="@+id/txt_estado_ranking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="42dp"
                    android:background="@drawable/bg_main_hero_card"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:padding="22dp"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="@string/ainda_sem_ranking" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_ranking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="8dp"
                    android:visibility="gone"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_ranking_jogador" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
