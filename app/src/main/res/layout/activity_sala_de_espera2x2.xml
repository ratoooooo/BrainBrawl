<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/bb_space_lg"
    android:background="@drawable/bg_app_gradient">

    <TextView
        android:id="@+id/txtTituloSala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sala_de_espera_2x2"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/bb_text_primary"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/txtCodigoSala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/c_digo_da_sala"
        android:textSize="18sp"
        android:background="@drawable/bg_empty_state_card"
        android:padding="@dimen/bb_space_md"
        android:textColor="@color/bb_text_primary"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="18dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_card_surface"
        android:padding="@dimen/bb_space_md">

        <!-- Equipa A -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center">

            <TextView
                android:id="@+id/txtEquipaA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equipa_a"
                android:textStyle="bold"
                android:textColor="@color/bb_team_a"
                android:textSize="20sp"
                android:layout_marginBottom="8dp" />

            <!-- Jogador 1 Equipa A -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="@color/bb_team_a" />
                <TextView
                    android:id="@+id/txtJogadorA1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aguardando"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="16sp"
                    android:layout_marginLeft="8dp"/>
            </LinearLayout>

            <!-- Jogador 2 Equipa A -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="@color/bb_team_a" />
                <TextView
                    android:id="@+id/txtJogadorA2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aguardando"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="16sp"
                    android:layout_marginLeft="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Barra divisória -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:background="@color/bb_outline" />

        <!-- Equipa B -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center">

            <TextView
                android:id="@+id/txtEquipaB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Equipa B"
                android:textStyle="bold"
                android:textColor="@color/bb_team_b"
                android:textSize="20sp"
                android:layout_marginBottom="8dp"/>

            <!-- Jogador 1 Equipa B -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="@color/bb_team_b" />
                <TextView
                    android:id="@+id/txtJogadorB1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aguardando"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="16sp"
                    android:layout_marginLeft="8dp"/>
            </LinearLayout>

            <!-- Jogador 2 Equipa B -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="@color/bb_team_b" />
                <TextView
                    android:id="@+id/txtJogadorB2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aguardando"
                    android:textColor="@color/bb_text_primary"
                    android:textSize="16sp"
                    android:layout_marginLeft="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnIniciarJogo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bb_button_height"
        android:text="@string/iniciar_jogo"
        android:enabled="false"
        android:textColor="@color/bb_secondary_text"
        android:background="@drawable/bg_button_secondary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btnSairSala"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bb_button_height"
        android:text="@string/sair_da_sala"
        android:enabled="true"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_button_danger"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

</LinearLayout>
