<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_premium"
    tools:context=".SalaDeEspera2x2Activity">

    <ImageButton
        android:id="@+id/btnBackHeader"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="42dp"
        android:background="@drawable/bg_choose_back_button"
        android:contentDescription="@string/voltar"
        android:padding="10dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/bb_luso_gold" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="88dp"
            android:paddingBottom="34dp">

            <TextView
                android:id="@+id/txtTituloSala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/sala_de_espera_2x2"
                android:textColor="@color/bb_luso_navy"
                android:textSize="31sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="126dp"
                android:layout_height="16dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#55D8C49D" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_accent_diamond" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#55D8C49D" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardStatusSala"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_main_mode_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/iconStatusSala"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_group"
                    app:tint="@color/bb_luso_gold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtStatusTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="@string/sala_status_2x2_invite"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtStatusDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/sala_status_2x2_invite_desc"
                        android:textColor="@color/bb_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCodigoSala"
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_main_hero_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/codigo_da_sala_label"
                        android:textColor="@color/bb_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtCodigoSala"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="@string/c_digo_da_sala"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCopiarCodigoSala"
                    android:layout_width="128dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button_secondary"
                    android:drawableStart="@drawable/ic_copy"
                    android:drawablePadding="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/copiar_codigo"
                    android:textAllCaps="false"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtEquipaA"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/equipa_a"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtEquipaB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:gravity="end"
                    android:text="@string/equipa_b"
                    android:textColor="@color/bb_luso_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="272dp"
                android:layout_marginTop="10dp"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/bg_waiting_slot"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/imgJogadorA1Avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/avatar_1_playstore" />

                    <TextView
                        android:id="@+id/txtJogadorA1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/aguardando"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/bg_waiting_slot"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/imgJogadorB1Avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_game_type_icon"
                        android:padding="10dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/bb_luso_navy" />

                    <TextView
                        android:id="@+id/txtJogadorB1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/aguardando"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/bg_waiting_slot"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/imgJogadorA2Avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_game_type_icon"
                        android:padding="10dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/bb_luso_navy" />

                    <TextView
                        android:id="@+id/txtJogadorA2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/aguardando"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/bg_waiting_slot"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/imgJogadorB2Avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_game_type_icon"
                        android:padding="10dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/bb_luso_navy" />

                    <TextView
                        android:id="@+id/txtJogadorB2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/aguardando"
                        android:textColor="@color/bb_luso_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </GridLayout>

            <Button
                android:id="@+id/btnIniciarJogo"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_main_black_button"
                android:fontFamily="sans-serif-black"
                android:text="@string/pronto"
                android:textAllCaps="false"
                android:textColor="@color/bb_primary_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSairSala"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_secondary"
                android:fontFamily="sans-serif-black"
                android:text="@string/sair_da_sala"
                android:textAllCaps="false"
                android:textColor="@color/bb_luso_navy"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_shield_clean"
                    app:tint="@color/bb_text_secondary" />

                <TextView
                    android:id="@+id/txtFooterInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/o_jogo_comeca_quatro_prontos"
                    android:textColor="@color/bb_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
