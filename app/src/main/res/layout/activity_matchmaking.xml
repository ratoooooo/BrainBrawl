<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:padding="@dimen/bb_space_lg">

    <TextView
        android:id="@+id/txtTituloMatchmaking"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Jogo aleatório"
        android:textAlignment="center"
        android:textColor="@color/bb_text_primary"
        android:textSize="@dimen/bb_title_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/cardMatchmaking"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <LinearLayout
        android:id="@+id/cardMatchmaking"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bb_space_lg"
        android:background="@drawable/bg_card_surface"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/bb_space_xl"
        app:layout_constraintBottom_toTopOf="@id/btnCancelarMatchmaking"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTituloMatchmaking">

        <ProgressBar
            android:id="@+id/progressMatchmaking"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/bb_primary" />

        <TextView
            android:id="@+id/txtEstadoMatchmaking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bb_space_lg"
            android:text="À procura de jogadores..."
            android:textAlignment="center"
            android:textColor="@color/bb_text_secondary"
            android:textSize="@dimen/bb_body_size" />

        <TextView
            android:id="@+id/txtContadorMatchmaking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bb_space_md"
            android:fontFamily="sans-serif-black"
            android:text="Jogadores à procura: 0/2"
            android:textAlignment="center"
            android:textColor="@color/bb_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtJogadoresMatchmaking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bb_space_md"
            android:background="@drawable/bg_input_surface"
            android:lineSpacingExtra="4dp"
            android:minHeight="88dp"
            android:padding="@dimen/bb_space_md"
            android:text="Aguardando jogadores..."
            android:textColor="@color/bb_text_secondary"
            android:textSize="15sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnCancelarMatchmaking"
        style="@style/BrainBrawlButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/bb_button_height"
        android:layout_marginTop="@dimen/bb_space_lg"
        android:background="@drawable/bg_button_danger"
        android:text="Cancelar"
        android:textColor="@color/bb_primary_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardMatchmaking" />

</androidx.constraintlayout.widget.ConstraintLayout>
